# Biflorica
BIFLORICA_EMAIL=you@example.com
BIFLORICA_PASSWORD=secret

# Почта (IMAP) — Яндекс
# https://yandex.ru/support/mail/mail-clients/imap.html
MAIL_EMAIL=you@yandex.ru
MAIL_PASSWORD=your-password-or-app-password
# MAIL_IMAP_HOST=imap.yandex.ru

# Сервер UI
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Playwright: true для сервера, false — видеть браузер при отладке
PLAYWRIGHT_HEADLESS=true

# Прокси для Playwright (del-mir, Biflorica и т.д.).
# Системный прокси Windows и TUN-режим Happ Playwright НЕ подхватывает —
# нужен явный локальный HTTP-порт Happ.
#
# В Happ:
#   1) включите сервер (подключение активно)
#   2) Settings → Advanced → Allow LAN Connections
#   3) возьмите HTTP Port (обычно 10809; SOCKS5 — 10808)
#   4) пропишите ниже HTTP, не SOCKS (Chromium стабильнее с http://)
#
# PLAYWRIGHT_PROXY=http://127.0.0.1:10809
# PLAYWRIGHT_PROXY=socks5://127.0.0.1:10808
# PLAYWRIGHT_PROXY_USERNAME=
# PLAYWRIGHT_PROXY_PASSWORD=
#
# Если одни серверы Happ работают, а другие нет — это узел (upstream),
# а не .env: порт в .env один и тот же для всех серверов Happ.
# Проверка с сервера (Happ включён):
#   curl -x http://127.0.0.1:10809 -I https://www.del-mir.com/login
# Если curl падает — смените сервер в Happ; в программу менять ничего не нужно.
