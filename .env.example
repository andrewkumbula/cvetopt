# Biflorica
BIFLORICA_EMAIL=you@example.com
BIFLORICA_PASSWORD=secret

# Почта (IMAP) — Яндекс
# https://yandex.ru/support/mail/mail-clients/imap.html
MAIL_EMAIL=you@yandex.ru
MAIL_PASSWORD=your-password-or-app-password
# MAIL_IMAP_HOST=imap.yandex.ru

# Сервер UI
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Playwright: true для сервера, false — видеть браузер при отладке
PLAYWRIGHT_HEADLESS=true

# Прокси для Playwright (обязательно, если на сервере доступ в интернет только через прокси).
# Системный прокси Windows / браузер пользователя Playwright НЕ подхватывает.
# Примеры:
# PLAYWRIGHT_PROXY=http://127.0.0.1:7890
# PLAYWRIGHT_PROXY=http://user:pass@127.0.0.1:7890
# PLAYWRIGHT_PROXY=socks5://127.0.0.1:1080
# PLAYWRIGHT_PROXY_USERNAME=
# PLAYWRIGHT_PROXY_PASSWORD=
